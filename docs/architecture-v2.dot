// BrokerVault architecture v2 (final). Source for docs/architecture-v2.png
// Render: dot -Tpng -Gdpi=200 architecture-v2.dot -o architecture-v2.png
digraph BrokerVault {
  graph [rankdir=TB, fontname="Helvetica", fontsize=22, labelloc=t, label="BrokerVault architecture (final, as deployed) · Pattern D: secure file intake", pad=0.4, nodesep=0.35, ranksep=0.55, bgcolor="white"];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=15, fillcolor="#FFFFFF", color="#3A3A3A", penwidth=1.4, margin="0.18,0.10"];
  edge  [fontname="Helvetica", fontsize=13, color="#3A3A3A", penwidth=1.3];

  subgraph cluster_users {
    label="Users (browser)"; style="rounded,filled"; fillcolor="#FFF3C4"; color="#F5B700"; fontsize=17;
    client [label="Client (borrower)\nMicrosoft or GitHub sign-in", fillcolor="#FFFDF7"];
    owner  [label="Owner: Maria (agent)\nGitHub sign-in · role owner", fillcolor="#FFFDF7"];
    mail   [label="Maria's mail app\n(reminder emails)", fillcolor="#FFFDF7"];
  }

  subgraph cluster_swa {
    label="Azure Static Web App  caa900-brokervault-web  (Free, East US 2) · public, HTTPS"; style="rounded,filled"; fillcolor="#F1EFEA"; color="#8A8170"; fontsize=17;
    auth [label="Built-in authentication\nroute rules by role\n(owner pages and /api/owner/* = owner only)"];
    fe   [label="Front end\nclient checklist + upload · owner dashboard\naffordability review · PDF export"];
    api  [label="API: Azure Functions (managed, consumption)\n12 functions · Node.js 20\nchecks the token and the role again in code"];
  }

  subgraph cluster_data {
    label="Storage account  caa900brokervaultdocs  (Canada Central) · private"; style="rounded,filled"; fillcolor="#E8F1FB"; color="#4A78B0"; fontsize=17;
    blob  [label="Blob container client-documents\nno anonymous access · AES-256\n5-minute SAS links · soft delete 7 days · versioning"];
    table [label="Table Storage\nClients · Documents · Audit · Reviews"];
  }

  subgraph cluster_ai {
    label="Canada Central"; style="rounded,dashed"; color="#8A8170"; fontsize=15;
    docint  [label="Document Intelligence (F0)\nOCR for scans and photos"];
    insights[label="Application Insights + Log Analytics\nrequest logs · 30 days"];
    alert   [label="Alert: API server errors\n→ email to owner"];
  }

  subgraph cluster_ops {
    label="Delivery (GitHub)"; style="rounded,filled"; fillcolor="#F4F4F4"; color="#8A8170"; fontsize=17;
    repo   [label="GitHub repository\ncode · infra/main.bicep · docs"];
    deploy [label="GitHub Actions: deploy\nsite + API on every push"];
    sonar  [label="GitHub Actions: SonarQube Cloud\ncode and security scan on every push"];
    bicep  [label="Bicep (az deployment)\ncreates every resource + tags"];
  }

  client -> auth [label="1 sign in"];
  owner  -> auth;
  auth -> fe;
  fe -> api [label="2 ask for upload link"];
  client -> blob [label="3 upload file directly (write-only SAS)", style=dashed, constraint=false];
  api -> blob  [label="4 check real file type, record"];
  api -> table [label="records + audit log"];
  api -> docint [label="read income (OCR)"];
  api -> insights [label="every request logged"];
  insights -> alert [constraint=false];
  fe -> mail [label="Send reminder", style=dashed];
  repo -> deploy [color="#8A8170"];
  deploy -> api [color="#8A8170", constraint=false];
  repo -> sonar [color="#8A8170"];
  repo -> bicep [color="#8A8170"];
  bicep -> table [style=dotted, color="#8A8170", label="provisions all resources", constraint=false];
}
